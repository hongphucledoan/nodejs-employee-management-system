# MongoDB Connection String
# ========================================

# Option 1: MongoDB Local (Recommended for development)
# Đảm bảo MongoDB server đang chạy trên máy local
DATABASE_URL="mongodb://localhost:27017/employee_management"

# Option 2: MongoDB Atlas Cloud (Production)
# Thay đổi: username, password, cluster_name theo thông tin của bạn
# DATABASE_URL="mongodb+srv://username:password@cluster_name.mongodb.net/employee_management?retryWrites=true&w=majority"

# Port cho Backend Server (mặc định: 3001)
PORT=3001

# Frontend Dev Server Port (Vite, mặc định: 5173)
VITE_API_URL="http://localhost:3001"
